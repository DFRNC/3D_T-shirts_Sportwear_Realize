# ─────────────────────────────────────────────────────────────────────────────
# Shopify — required
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. When false the app serves the local catalog only: raw model ids as product names
# and 0.00 EUR prices. Never leave it unset in production.
SHOPIFY_ENABLED=true

SHOPIFY_STORE_DOMAIN=realize2-0.myshopify.com
SHOPIFY_API_VERSION=2025-01

# Which API the GraphQL client talks to: "storefront" or "admin".
# Leave empty to auto-detect — it picks "storefront" when SHOPIFY_STOREFRONT_ACCESS_TOKEN is set and
# falls back to "admin" otherwise. Set it explicitly to avoid a missing token silently switching
# modes and then failing on a different variable than you expect.
SHOPIFY_API_MODE=

# Catalog reads. Required when SHOPIFY_API_MODE=storefront.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Shopify Admin API — required for checkout, file uploads and the order webhook
# ─────────────────────────────────────────────────────────────────────────────

# Two ways to authenticate; pick one.
#   a) a long-lived token from a custom app:
SHOPIFY_ADMIN_ACCESS_TOKEN=
#   b) client credentials, exchanged for a short-lived token automatically:
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# NOTE: SHOPIFY_ADMIN_CLIENT_SECRET doubles as the HMAC key for the orders/create webhook.
# That is correct only when the subscription was created through the app's Admin API. A webhook
# added by hand in the Shopify admin UI is signed with its own signing secret — using the client
# secret there rejects every delivery with 401.

# ─────────────────────────────────────────────────────────────────────────────
# Storefront collections
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated collection handles shown on the home page. Defaults to
# completo-gara-calcio,completo-gara-pallavolo,completo-gara-basket,completo
SHOPIFY_HOME_COLLECTION_HANDLES=

# ─────────────────────────────────────────────────────────────────────────────
# Embedding — which storefront may frame the configurator
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated origins added to the CSP frame-ancestors directive, on top of the store domain and
# Shopify's own theme editor/preview origins. This is the ONLY way to authorise an embedder: it is
# deliberately not derived from the request. Set it to the storefront's custom domain.
#   e.g. SHOPIFY_FRAME_ANCESTORS=https://client-shop.com,https://www.client-shop.com
SHOPIFY_FRAME_ANCESTORS=

# The same list for the client bundle — it gates postMessage traffic with the parent frame, so it
# must mirror SHOPIFY_FRAME_ANCESTORS. NEXT_PUBLIC_* values are inlined at build time, so these have
# to be present when `next build` runs, not only at runtime.
NEXT_PUBLIC_SHOPIFY_PARENT_ORIGINS=
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=realize2-0.myshopify.com

# ─────────────────────────────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of this app. Behind a reverse proxy the request URL is the internal upstream
# address, which would otherwise end up in the download links baked into every order PDF.
APP_PUBLIC_ORIGIN=https://configurator.client-shop.com

# Exposes /dev/last-order-export and /dev/order-cutting-export, which render the most recent order
# in full: customer email, shipping address, the raw order JSON and links to the print assets.
# Staging only — leave unset in production.
DEV_ROUTES_ENABLED=
