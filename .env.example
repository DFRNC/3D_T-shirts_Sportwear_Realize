SHOPIFY_ENABLED=true
SHOPIFY_API_VERSION=2025-01

SHOPIFY_STORE_DOMAIN=realize-sport.myshopify.com
# Comma-separated storefront hostnames allowed to embed the configurator iframe.
SHOPIFY_HOSTS=www.realizesport.com,realizesport.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

SHOPIFY_SHOPS=realizesport
SHOPIFY_SHOP_REALIZESPORT_STORE_DOMAIN=realize-sport.myshopify.com
SHOPIFY_SHOP_REALIZESPORT_HOSTS=www.realizesport.com,realizesport.com
SHOPIFY_SHOP_REALIZESPORT_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_SHOP_REALIZESPORT_ADMIN_CLIENT_ID=
SHOPIFY_SHOP_REALIZESPORT_ADMIN_CLIENT_SECRET=
# Optional full origins (https://...) for frame-ancestors CSP.
SHOPIFY_FRAME_ANCESTORS=https://www.realizesport.com,https://realizesport.com
REDIS_URL=

# Coolify: set these in Environment Variables (not baked into the image).
# Optional overrides:
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_API_MODE=storefront
# SHOPIFY_HOME_COLLECTION_HANDLES=completo-gara-calcio,completo-gara-pallavolo,completo-gara-basket,completo
