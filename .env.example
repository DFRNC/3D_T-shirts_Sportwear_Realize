SHOPIFY_ENABLED=true
# Мусить бути з переліку підтримуваних версій — застарілі Shopify мовчки
# відкочує на найстарішу живу, і поведінка змінюється без змін у коді.
SHOPIFY_API_VERSION=2025-10

# Storefront API + frame-ancestors. Тут допустимий кастомний домен.
SHOPIFY_STORE_DOMAIN=realize-sport.myshopify.com
# Admin API host — тільки *.myshopify.com, ніколи не кастомний домен:
# кастомний редіректить на admin.shopify.com, де Cloudflare віддає 403.
SHOPIFY_ADMIN_STORE_DOMAIN=realize-sport.myshopify.com
# Хости, яким дозволено вбудовувати конфігуратор в iframe (через кому).
SHOPIFY_HOSTS=www.realizesport.com,realizesport.com

SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Постійний Admin API токен. Потрібні scopes:
# read_products, read_orders, write_orders, read_files, write_files
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Ним перевіряється HMAC-підпис вебхука orders/create — без нього вебхук віддає 500.
# Має належати тому ж аппу, що надсилає вебхук.
SHOPIFY_ADMIN_CLIENT_SECRET=

# SHOPIFY_ADMIN_CLIENT_ID навмисно не задається: якщо є і id, і secret,
# resolveShopifyAdminAccessToken йде в client_credentials grant, а він
# на платному магазині падає з "Oauth error shop_not_permitted".
# Цей grant працює лише на dev store у межах тієї ж організації.

# Опційні повні origin-и (https://...) для frame-ancestors CSP.
SHOPIFY_FRAME_ANCESTORS=https://www.realizesport.com,https://realizesport.com
# Черга обробки вебхуків orders/create. Без неї вебхук обробляється синхронно.
REDIS_URL=
 
# Опційні перевизначення:
# SHOPIFY_API_MODE=storefront
# SHOPIFY_REQUEST_TIMEOUT_MS=
# SHOPIFY_HOME_COLLECTION_HANDLES=completo-gara-calcio,completo-gara-pallavolo,completo-gara-basket,completo
# Мультимагазинність (frame-ancestors): SHOPIFY_SHOPS=shop1,shop2 плюс
# SHOPIFY_SHOP_<SHOP>_HOSTS / _STORE_DOMAIN для кожного.
