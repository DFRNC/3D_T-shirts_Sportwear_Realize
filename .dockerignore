# Never ship the dev cache — it reached 2.6 GB in .next/dev during local development.
.next
node_modules
.git
.gitignore

# Secrets stay in the platform's environment, never in the image.
.env
.env.*
!.env.example

tests
playwright.config.ts
playwright-report
test-results
coverage

.vscode
.idea
.claude
*.log
*.tmp.mjs
Dockerfile
.dockerignore
docker-compose.yml
